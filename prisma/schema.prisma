// AcessibilityMap — Schema Prisma
// Banco: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis aceitos no sistema.
enum PerfilUsuario {
  DEFICIENCIA_VISUAL
  DEFICIENCIA_FISICA
  DEFICIENCIA_AUDITIVA
  DEFICIENCIA_MOTORA
  NENHUMA
}

model usuario {
  id                    String        @id @default(uuid())
  name                  String?
  email                 String        @unique @db.VarChar(180)
  password              String
  role                  PerfilUsuario
  avaliacoes            Avaliacao[]
  createdat             DateTime      @default(now())
  updatedat             DateTime      @default(now())
  localizationLatitude  String?
  localizationLongitude String?
  visualization         Boolean       @default(true)
  isAdmin               Boolean       @default(false)
}

model localAcessibilidade {
  id                String   @id @default(uuid())
  name              String
  description       String?
  latitude          String
  longitude         String
  accessibilityType String
  avaliacoes        Avaliacao[]
  mediaAvaliacoes   Float?      @default(0)
  totalAvaliacoes   Int         @default(0)
  createdat         DateTime @default(now())
  updatedat         DateTime @default(now())
  visualization     Boolean  @default(true)
}

model Avaliacao {
  id          String      @id @default(uuid())
  nota        Int
  comentario  String?
  localId     String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  local       localAcessibilidade @relation(fields: [localId], references: [id], onDelete: Cascade)
  usuario     usuario             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([localId, userId]) // 1 avaliação por usuário por local
}